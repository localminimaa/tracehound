# Solana: RPC + Parsed Events (10 credits a request; free plan ~1M credits a month)
# HELIUS_FALLBACK_KEYS=key2,key3   used in turn when a key runs out of credits or is rate limited
# HELIUS_DAILY_CREDITS=33000   daily budget shared by server, sampler, ring scan and CLI
HELIUS_API_KEY=
# Plain Solana RPC through other providers first, each within its own plan (comma-separated endpoints, e.g. Chainstack
# and QuickNode); Helius answers what they cannot and keeps DAS and parsed APIs. SOLANA_RPC_RPS per provider, default 8.
SOLANA_RPC_URLS=
# EVM: one Etherscan v2 key covers all chains (free tier may not cover Base/BSC/OP)
ETHERSCAN_API_KEY=
# Tron: works without a key at a low rate; a free key from trongrid.io makes it much faster
TRONGRID_API_KEY=
# Address labels (exchanges, bridges, mixers) via labels.addresses
DUNE_API_KEY=
# Same query within N hours reuses the saved case (no API calls)
CASE_REUSE_HOURS=6

PORT=8787
# Trace limits — raise for deeper cases, lower for speed
MAX_DEPTH=3
BRANCHES=4
MAX_NODES=80
# How many times the trace may follow money across THORChain onto another chain
MAX_HOPS=2

# Token check sample for the accuracy table: check SAMPLE_N fresh Solana tokens every SAMPLE_EVERY_H hours (Helius credits). Off when empty.
SAMPLE_EVERY_H=
SAMPLE_N=5

# Token check on Base / BSC reads balances through these public RPCs (publicnode by default)
BASE_RPC_URL=
BSC_RPC_URL=

# Public deploy: only requests with this token in the x-label-token header may add labels. Empty = anyone (local use).
LABEL_TOKEN=

# Public deploy behind Caddy: client IP from X-Forwarded-For, secure cookies, daily plan limits on
TRUST_PROXY=
# Daily plan limits without a proxy (they are off in local development)
ENFORCE_LIMITS=

# Plan payments in USDC land in these wallets; a chain left empty is not offered, both empty = payments off
PAY_SOLANA_ADDRESS=
PAY_BASE_ADDRESS=

# Telegram bot (npm run bot): the token from @BotFather, and the bot's username so the account page can link to it
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_NAME=
